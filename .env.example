# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
TRUST_PROXY=true

# ---------------------------------------------------------------- secrets
# تولید کلید تصادفی:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_MASTER_KEY=dev-master-key-change-me-please-32
JWT_SECRET=dev-jwt-secret-change-me-please-32
ADMIN_SEED_EMAIL=admin@botforge.local
ADMIN_SEED_PASSWORD=ChangeMe#2026

# ---------------------------------------------------------------- database
# auto | postgres | sqlite | d1 | memory
DATABASE_DRIVER=sqlite
SQLITE_PATH=.data/botforge.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/botforge

# ---------------------------------------------------------------- webhooks
WEBHOOK_PATH_PREFIX=/webhooks
WEBHOOK_MAX_SKEW_SECONDS=300

# ---------------------------------------------------------------- media
MEDIA_DIR=.data/media
MEDIA_PUBLIC_PREFIX=/media
MAX_UPLOAD_MB=48

# ---------------------------------------------------------------- limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=240
BROADCAST_RATE_PER_SECOND=5
BROADCAST_BATCH_SIZE=25
QUEUE_CONCURRENCY=4
QUEUE_POLL_INTERVAL_MS=2000

# ---------------------------------------------------------------- integrations
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
SPEECH_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
GOLD_API_KEY=
EXCHANGE_API_KEY=

# ---------------------------------------------------------------- security
CORS_ORIGINS=*
SSRF_PROTECTION=true
