{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@botforge/core": ["packages/core/src/index.ts"],
      "@botforge/platform-adapters": ["packages/platform-adapters/src/index.ts"],
      "@botforge/bot-templates": ["packages/bot-templates/src/index.ts"],
      "@botforge/engine": ["packages/engine/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["**/node_modules", "**/dist"]
}
